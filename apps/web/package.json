{
  "name": "smartoffice-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:compat": "node scripts/dev.mjs --compat",
    "dev:web": "next dev --webpack --hostname 127.0.0.1",
    "dev:web:compat": "node scripts/next-compat.mjs dev",
    "test:launcher": "node --test scripts/dev.test.mjs",
    "build": "next build --webpack",
    "build:compat": "node scripts/next-compat.mjs build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.4.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
