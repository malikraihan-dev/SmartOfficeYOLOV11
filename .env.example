# Template environment Docker Compose untuk Smart Office YOLOv11
# Salin menjadi .env di root proyek bila ingin menyesuaikan nilai bawaan:
#   Copy-Item .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartoffice
POSTGRES_HOST_PORT=5433

# Mosquitto MQTT
MQTT_HOST_PORT=1883
MQTT_TOPIC=smartoffice/scd40/telemetry

# Akun admin awal (opsional saat docker compose up; isi password 12-128 karakter atau buat via:
#   docker compose exec backend python manage_admin.py)
SMARTOFFICE_ADMIN_USER=admin
# SMARTOFFICE_ADMIN_PASSWORD=ganti-password-minimal-12-karakter

# Opsional: isi 1 hanya untuk data uji coba awal (jangan dipakai untuk dataset SCD40 asli)
SMARTOFFICE_AUTO_SEED=0

# Opsional: URL RTSP/HTTP atau index kamera jika menjalankan kamera di Docker
# SMARTOFFICE_CAMERA_SOURCE=
