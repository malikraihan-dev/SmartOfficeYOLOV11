# Konfigurasi Database Backend Smart Office YOLOv11
# Isi DATABASE_URL untuk memakai PostgreSQL. Jika dikosongkan/dikomentari, otomatis memakai SQLite lokal (smartoffice.db).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smartoffice

# Opsional: Database terpisah untuk autentikasi admin (default mengikuti DATABASE_URL bila diatur, atau instance/admin_auth.db)
# SMARTOFFICE_AUTH_DB=postgresql://postgres:postgres@127.0.0.1:5432/smartoffice

# Origin frontend Next.js yang diizinkan untuk login dan CORS sesi
SMARTOFFICE_WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# Konfigurasi MQTT Mosquitto untuk Sensor SCD40 (ESP32-S3)
MQTT_ENABLED=1
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_TOPIC=smartoffice/scd40/telemetry
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Opsional: Token autentikasi perangkat ESP32 SCD40
# SMARTOFFICE_DEVICE_TOKEN=rahasia-perangkat-anda
